# Supabase (PostgreSQL via Supabase)
# Get these from Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Direct database URL (optional - for Prisma if used)
# DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# Stripe (the only payment method): Dashboard → Developers → API keys and Webhooks
# Use test keys (sk_test_…) everywhere except production.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
