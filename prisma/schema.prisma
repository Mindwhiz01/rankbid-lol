// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x is Vercel's runtime: deploys are built on this Mac (scripts/deploy.sh) and need its engine too.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id            String    @id @default(cuid())

  title         String
  description   String
  url           String    @unique
  handle        String?
  category      Category  @default(Other)
  platform      String    @default("website")

  totalVotes    Int       @default(0)
  dayVotes      Int       @default(0)
  clickCount    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  votes         Vote[]
  dailySnapshots DailyVoteSnapshot[]

  @@index([category])
  @@index([totalVotes])
  @@index([dayVotes])
  @@index([createdAt])
  @@map("listings")
}

model Vote {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  voterId   String   @map("voter_id")
  votedAt   DateTime @default(now()) @map("voted_at")

  @@unique([listingId, voterId])
  @@index([listingId])
  @@index([voterId])
  @@map("votes")
}

model UserVote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String   @map("listing_id")
  votedAt   DateTime @default(now()) @map("voted_at")

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
  @@map("user_votes")
}

model DailyVoteSnapshot {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  date      DateTime @map("date")
  votes     Int      @map("votes")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([listingId, date])
  @@index([date])
  @@map("daily_vote_snapshots")
}

model DailySnapshot {
  id        String   @id @default(cuid())
  date      DateTime @unique // UTC date (midnight)

  // Snapshot of top 10 for that day (for archiving/historical pages)
  data      Json     // Array of { listing, rank, amount }

  frozen    Boolean  @default(false) // Once midnight passes, snapshot freezes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@map("daily_snapshots")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions  Session[]
  votes     UserVote[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

enum Category {
  All
  Technology  // ٹیکنالوجی
  ECommerce   // ای کامرس
  DigitalMarketing // ڈیجیٹل مارکیٹنگ
  Education   // تعلیم
  Health      // صحت
  Fashion     // فیشن
  Food        // کھانا
  Travel      // سفر
  Business    // بزنس
  Other       // دیگر
}
